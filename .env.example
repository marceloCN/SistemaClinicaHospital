APP_NAME="Sistema CMS"
APP_ENV=local
APP_URL=http://localhost:8095
APP_DEBUG=true

# APP_KEY queda reservado para futuras funciones de cifrado. Hoy el CMS no lo usa.

# Base de datos.
# Para PostgreSQL local: DB_CONNECTION=pgsql, DB_HOST=localhost, DB_PORT=5433
# Para PostgreSQL desde contenedor Docker hacia el host: DB_HOST=host.docker.internal
# El sistema crea las tablas base automaticamente en ambos gestores.
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5433
DB_DATABASE=medicina
DB_USERNAME=postgres
DB_PASSWORD=tu_password
DB_CHARSET=utf8

TIMEZONE=America/La_Paz
LANGUAGE=es

SESSION_LIFETIME=120

# Solo para desarrollo. En produccion APP_DEBUG=false.
